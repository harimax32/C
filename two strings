#include <stdio.h>
#include <string.h>
#include <stdbool.h>


const char* twoStrings(char* s1, char* s2) {

    bool char_set[26] = {false};

    for (int i = 0; s1[i] != '\0'; i++) {
        int index = s1[i] - 'a';
        char_set[index] = true;
    }


    for (int i = 0; s2[i] != '\0'; i++) {
        int index = s2[i] - 'a';
        if (char_set[index]) {
            return "YES";
        }
    }

    return "NO";
}

int main() {
    int q;
    if (scanf("%d", &q) != 1) return 0;


    static char s1[100005];
    static char s2[100005];

    while (q--) {
        scanf("%s", s1);
        scanf("%s", s2);
        
        printf("%s\n", twoStrings(s1, s2));
    }

    return 0;
}
