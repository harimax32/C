#include <string.h>
void reverse(char* start, char* end) {
    while (start < end) {
        char temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
}
char* reverseWords(char* s) {
    int n = strlen(s);
    reverse(s, s + n - 1);
    int writeIdx = 0;
    for (int i = 0; i < n; i++) {
        if (s[i] != ' ') {
         
            if (writeIdx != 0) {
                s[writeIdx++] = ' ';
            }
            
            int wordStart = writeIdx;
            
            
            while (i < n && s[i] != ' ') {
                s[writeIdx++] = s[i++];
            }
            
   
            reverse(s + wordStart, s + writeIdx - 1);
        }
    }
    s[writeIdx] = '\0';
    return s;
}
