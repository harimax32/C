#include <stdio.h>
#include <stdlib.h>

void rotateLeft(int n, int d, int* arr) {
 
    d = d % n;

    int* rotated_arr = (int*)malloc(n * sizeof(int));
    if (rotated_arr == NULL) return;

    for (int i = 0; i < n; i++) {
        int new_index = (i - d + n) % n;
        rotated_arr[new_index] = arr[i];
    }


    for (int i = 0; i < n; i++) {
        printf("%d", rotated_arr[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");


    free(rotated_arr);
}

int main() {
    int n, d;

    if (scanf("%d %d", &n, &d) != 2) return 0;


    int* arr = (int*)malloc(n * sizeof(int));
    if (arr == NULL) return 0;

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 0;
        }
    }


    rotateLeft(n, d, arr);

    
    free(arr);
    return 0;
}

